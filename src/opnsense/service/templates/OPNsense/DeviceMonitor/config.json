{#
    Resolve the settings node defensively. Before the first migration runs
    there is no OPNsense/DeviceMonitor node at all, and Jinja's default
    Undefined raises on attribute access, so walking the path directly would
    abort the render instead of falling back to the defaults below.
#}
{% set dm = ((OPNsense|default({})).get('DeviceMonitor') or {}).get('general') or {} %}
{
    "enabled": {{ dm.enabled|default('0')|tojson }},
    "monitor_interfaces": {{ dm.monitor_interfaces|default('')|tojson }},
    "log_level": {{ dm.log_level|default('info')|tojson }},
    "scan_interval": {{ dm.scan_interval|default('300')|tojson }},
    "notify_events": {{ dm.notify_events|default('new')|tojson }},
    "email_enabled": {{ dm.email_enabled|default('0')|tojson }},
    "email_to": {{ dm.email_to|default('')|tojson }},
    "email_from": {{ dm.email_from|default('devicemonitor@opnsense.local')|tojson }},
    "email_method": {{ dm.email_method|default('sendmail')|tojson }},
    "smtp_host": {{ dm.smtp_host|default('')|tojson }},
    "smtp_port": {{ dm.smtp_port|default('587')|tojson }},
    "smtp_encryption": {{ dm.smtp_encryption|default('starttls')|tojson }},
    "smtp_username": {{ dm.smtp_username|default('')|tojson }},
    "smtp_password": {{ dm.smtp_password|default('')|tojson }},
    "email_interfaces": {{ dm.email_interfaces|default('')|tojson }},
    "webhook_enabled": {{ dm.webhook_enabled|default('0')|tojson }},
    "webhook_type": {{ dm.webhook_type|default('auto')|tojson }},
    "webhook_insecure": {{ dm.webhook_insecure|default('0')|tojson }},
    "webhook_url": {{ dm.webhook_url|default('')|tojson }},
    "webhook_interfaces": {{ dm.webhook_interfaces|default('')|tojson }}
}
