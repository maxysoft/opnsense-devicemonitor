<model>
    <mount>//OPNsense/DeviceMonitor</mount>
    <version>1.0.0</version>
    <description>Device Monitor settings</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <scan_interval type="IntegerField">
                <Default>300</Default>
                <Required>Y</Required>
                <MinimumValue>60</MinimumValue>
                <MaximumValue>3600</MaximumValue>
                <ValidationMessage>The scan interval must be between 60 and 3600 seconds.</ValidationMessage>
            </scan_interval>

            <email_enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </email_enabled>
            <email_to type="EmailField">
                <ValidationMessage>Please enter a valid recipient address.</ValidationMessage>
            </email_to>
            <email_from type="EmailField">
                <Default>devicemonitor@opnsense.local</Default>
                <Required>Y</Required>
                <ValidationMessage>Please enter a valid sender address.</ValidationMessage>
            </email_from>
            <email_method type="OptionField">
                <Default>sendmail</Default>
                <Required>Y</Required>
                <OptionValues>
                    <sendmail>Local Sendmail / Postfix</sendmail>
                    <smtp>Direct SMTP</smtp>
                </OptionValues>
            </email_method>
            <smtp_host type="HostnameField">
                <IpAllowed>Y</IpAllowed>
                <ValidationMessage>Please enter a valid hostname or IP address.</ValidationMessage>
            </smtp_host>
            <smtp_port type="PortField">
                <Default>587</Default>
                <Required>Y</Required>
                <EnableWellKnown>Y</EnableWellKnown>
            </smtp_port>
            <smtp_encryption type="OptionField">
                <Default>starttls</Default>
                <Required>Y</Required>
                <OptionValues>
                    <starttls>STARTTLS</starttls>
                    <ssl>SSL/TLS</ssl>
                    <none>None</none>
                </OptionValues>
            </smtp_encryption>
            <smtp_username type="TextField"/>
            <smtp_password type="TextField"/>
            <!-- Comma separated list of the VLAN labels produced by
                 scan_network.py (for example VLAN11). Empty means every
                 interface. Deliberately not an InterfaceField: the device
                 table stores those generated labels, not OPNsense interface
                 identifiers, so the two would never match. -->
            <email_vlans type="TextField">
                <Mask>/^[0-9A-Za-z_.,-]*$/</Mask>
                <ValidationMessage>Only interface labels separated by commas are allowed.</ValidationMessage>
            </email_vlans>

            <webhook_enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </webhook_enabled>
            <webhook_url type="UrlField">
                <ValidationMessage>Please enter a valid URL.</ValidationMessage>
            </webhook_url>
            <webhook_vlans type="TextField">
                <Mask>/^[0-9A-Za-z_.,-]*$/</Mask>
                <ValidationMessage>Only interface labels separated by commas are allowed.</ValidationMessage>
            </webhook_vlans>
        </general>
    </items>
</model>
