<model>
    <mount>//OPNsense/DeviceMonitor</mount>
    <version>1.0.0</version>
    <description>Device Monitor settings</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <!-- Empty means every assigned interface. -->
            <monitor_interfaces type="InterfaceField">
                <Multiple>Y</Multiple>
            </monitor_interfaces>
            <!-- debug adds the per-request detail needed to diagnose a
                 delivery failure. It is noisy, so it is not the default. -->
            <log_level type="OptionField">
                <Default>info</Default>
                <Required>Y</Required>
                <OptionValues>
                    <info>Normal</info>
                    <debug>Debug (verbose)</debug>
                </OptionValues>
            </log_level>
            <scan_interval type="IntegerField">
                <Default>300</Default>
                <Required>Y</Required>
                <MinimumValue>60</MinimumValue>
                <MaximumValue>3600</MaximumValue>
                <ValidationMessage>The scan interval must be between 60 and 3600 seconds.</ValidationMessage>
            </scan_interval>

            <!-- Which events raise a notification. Applies to both channels.
                 Required, so at least one event is always selected; turn a
                 channel off to stop its notifications. -->
            <notify_events type="OptionField">
                <Default>new</Default>
                <Required>Y</Required>
                <Multiple>Y</Multiple>
                <OptionValues>
                    <new>A new device appears</new>
                    <up>A known device comes online</up>
                    <down>A known device goes offline</down>
                </OptionValues>
            </notify_events>

            <!-- Off by default. A fresh install has no recipient configured,
                 and performValidation() requires one once this is on, so
                 defaulting to 1 would make the model invalid with its own
                 defaults and abort the initial migration. -->
            <email_enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </email_enabled>
            <email_to type="EmailField">
                <ValidationMessage>Please enter a valid recipient address.</ValidationMessage>
            </email_to>
            <email_from type="EmailField">
                <Default>devicemonitor@opnsense.local</Default>
                <Required>Y</Required>
                <ValidationMessage>Please enter a valid sender address.</ValidationMessage>
            </email_from>
            <email_method type="OptionField">
                <Default>sendmail</Default>
                <Required>Y</Required>
                <OptionValues>
                    <sendmail>Local Sendmail / Postfix</sendmail>
                    <smtp>Direct SMTP</smtp>
                </OptionValues>
            </email_method>
            <smtp_host type="HostnameField">
                <IpAllowed>Y</IpAllowed>
                <ValidationMessage>Please enter a valid hostname or IP address.</ValidationMessage>
            </smtp_host>
            <smtp_port type="PortField">
                <Default>587</Default>
                <Required>Y</Required>
                <EnableWellKnown>Y</EnableWellKnown>
            </smtp_port>
            <smtp_encryption type="OptionField">
                <Default>starttls</Default>
                <Required>Y</Required>
                <OptionValues>
                    <starttls>STARTTLS</starttls>
                    <ssl>SSL/TLS</ssl>
                    <none>None</none>
                </OptionValues>
            </smtp_encryption>
            <smtp_username type="TextField"/>
            <smtp_password type="TextField"/>
            <!-- Empty means notify for every interface. The scanner stores the
                 OPNsense interface key against each device, so these line up. -->
            <email_interfaces type="InterfaceField">
                <Multiple>Y</Multiple>
            </email_interfaces>

            <webhook_enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </webhook_enabled>
            <!-- Explicit beats guessing from the URL, which got both a
                 self-hosted ntfy and a generic endpoint wrong. -->
            <webhook_type type="OptionField">
                <Default>auto</Default>
                <Required>Y</Required>
                <OptionValues>
                    <auto>Detect from the URL</auto>
                    <generic>Generic JSON</generic>
                    <ntfy>ntfy</ntfy>
                    <discord>Discord</discord>
                </OptionValues>
            </webhook_type>
            <!-- Only for a self-signed endpoint. The URL of a webhook is
                 usually itself the credential, so skipping verification
                 exposes it to anyone on the path. -->
            <webhook_insecure type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </webhook_insecure>
            <webhook_url type="UrlField">
                <ValidationMessage>Please enter a valid URL.</ValidationMessage>
            </webhook_url>
            <webhook_interfaces type="InterfaceField">
                <Multiple>Y</Multiple>
            </webhook_interfaces>
        </general>
    </items>
</model>
